[
    {
        "question": {
            "id": 40,
            "category": "fault_tolerance",
            "intent": "sync_durability_pending_writes_crash_recovery",
            "difficulty": "very_hard",
            "question": "A production LangGraph workflow uses durability='sync' with a database checkpointer. A node performs an external side effect such as sending an email and then returns successfully. The process is forcibly terminated at a carefully chosen point during the same superstep. After restart, the node sometimes executes again and the email is sent twice. The same code and graph can appear exactly-once after a restart on one machine but duplicate the side effect on another machine. Review the Pregel persistence implementation and checkpoint interface and explain how put_writes() and put() are scheduled, what durability='sync' actually guarantees, how pending writes allow completed tasks to be recovered after sibling failures, why checkpoint persistence and pending-write persistence can still race within a superstep, how recovery decides between replaying a completed task's writes and re-executing the task, and why external side effects therefore cannot safely be treated as exactly-once merely because sync durability is enabled.",
            "expected_files": [
                "fault-tolerance.mdx",
                "persistence.mdx",
                "langgraph/langgraph/pregel/_loop.py",
                "langgraph/langgraph/pregel/_runner.py",
                "langgraph/langgraph/pregel/_executor.py",
                "langgraph/langgraph/pregel/_checkpoint.py",
                "checkpoint/langgraph/checkpoint/base/__init__.py",
                "checkpoint-sqlite/langgraph/checkpoint/sqlite/__init__.py"
            ],
            "concepts": [
                "durability='sync'",
                "pending writes",
                "checkpoint persistence",
                "put_writes",
                "put",
                "crash recovery",
                "replay",
                "task re-execution",
                "external side effects",
                "idempotency",
                "exactly-once semantics"
            ],
            "tags": [
                "durability",
                "sync",
                "pending_writes",
                "crash_recovery",
                "replay",
                "side_effects",
                "idempotency",
                "exactly_once"
            ],
            "code_snippet": "from typing import TypedDict\nfrom langgraph.graph import StateGraph, START, END\nfrom langgraph.checkpoint.sqlite import SqliteSaver\n\nclass State(TypedDict):\n    step: int\n\ndef charge_customer(state: State):\n    # External side effect: payment provider is called here.\n    charge_payment_provider()\n    return {\"step\": state[\"step\"] + 1}\n\ndef next_step(state: State):\n    return {\"step\": state[\"step\"] + 1}\n\nbuilder = StateGraph(State)\nbuilder.add_node(\"charge\", charge_customer)\nbuilder.add_node(\"next\", next_step)\nbuilder.add_edge(START, \"charge\")\nbuilder.add_edge(\"charge\", \"next\")\nbuilder.add_edge(\"next\", END)\n\nwith SqliteSaver.from_conn_string(\"checkpoints.db\") as checkpointer:\n    graph = builder.compile(checkpointer=checkpointer)\n    graph.invoke(\n        {\"step\": 0},\n        {\n            \"configurable\": {\"thread_id\": \"payment-42\"},\n            \"durability\": \"sync\",\n        },\n    )\n\n# The process is forcibly terminated after the external payment succeeds\n# but during checkpoint persistence. Restart the application and resume\n# the same thread.",
            "observed_behavior": "After a crash, the same successful node can execute again, causing a duplicated external side effect. The outcome can depend on the timing of checkpoint and pending-write persistence.",
            "expected_behavior": "The application should understand that durable checkpointing does not provide exactly-once semantics for arbitrary external side effects and should use idempotency or task boundaries appropriate for durable execution.",
            "error": null,
            "logs": null,
            "evidence": null,
            "queries": [
                "What does durability='sync' guarantee in LangGraph and what does it not guarantee?",
                "How are checkpointer.put_writes and checkpointer.put scheduled during a Pregel superstep?",
                "Why are pending writes persisted separately from the main checkpoint?",
                "How does crash recovery determine whether a completed task can be replayed from pending writes?",
                "Under what circumstances can a successfully completed node execute again after process failure?",
                "Why can persistence ordering affect whether a node's external side effect is duplicated after recovery?"
            ]
        },
