                "msgpack",
                "pickle",
                "checkpoint"
            ],
            "code_snippet": "from dataclasses import dataclass\nfrom typing import TypedDict\nfrom langgraph.graph import StateGraph, START, END\nfrom langgraph.checkpoint.memory import InMemorySaver\n\n@dataclass\nclass UserContext:\n    user_id: str\n    role: str\n\nclass State(TypedDict):\n    context: UserContext\n\ndef use_context(state):\n    return {\"context\": state[\"context\"]}\n\nbuilder = StateGraph(State)\nbuilder.add_node(\"use\", use_context)\nbuilder.add_edge(START, \"use\")\nbuilder.add_edge(\"use\", END)\ngraph = builder.compile(checkpointer=InMemorySaver())\n\nconfig = {\"configurable\": {\"thread_id\": \"types-1\"}}\ngraph.invoke({\"context\": UserContext(\"u1\", \"admin\")}, config)\n# Simulate restart and resume from the persisted checkpoint.",
            "observed_behavior": "",
            "expected_behavior": "",
            "error": "",
            "logs": null,
            "evidence": null,
            "queries": [
                "How does JsonPlusSerializer encode Python types in LangGraph checkpoints?",
                "How does LangGraph reconstruct custom objects during checkpoint deserialization?",
                "When does JsonPlusSerializer use msgpack versus pickle or other fallbacks?",
                "How can checkpoint deserialization produce a different runtime type from the original state?",
                "What does LANGGRAPH_STRICT_MSGPACK change about checkpoint deserialization?",
                "Why can a serialization compatibility problem surface only after restarting and resuming a graph?"
            ]
