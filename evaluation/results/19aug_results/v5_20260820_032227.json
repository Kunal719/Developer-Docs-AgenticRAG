                "checkpoint/langgraph/checkpoint/serde/base.py",
                "checkpoint/langgraph/checkpoint/serde/jsonplus.py",
                "checkpoint/langgraph/checkpoint/serde/encrypted.py",
                "checkpoint/langgraph/checkpoint/base/__init__.py",
                "persistence.mdx"
            ],
            "concepts": [
                "checkpoint serialization",
                "deserialization",
                "JsonPlusSerializer",
                "type reconstruction",
                "msgpack",
                "pickle fallback",
                "strict deserialization"
