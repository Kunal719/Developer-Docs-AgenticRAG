        "question": {
            "id": 24,
            "category": "debugging",
            "intent": "parallel_interrupt_id_collision",
            "difficulty": "very_hard",
            "question": "A ToolNode executes several tools concurrently and each tool calls interrupt(). The graph reports multiple pending interrupts, but the interrupt IDs are identical, so constructing Command(resume={interrupt_id: value}) can only address one tool. Explain how interrupt IDs are derived, which execution namespace participates in the ID generation, why parallel tool executions can share that namespace, why an interrupt counter alone does not necessarily make the generated IDs unique, and how the task-local resume mechanism differs from the namespace-derived interrupt identity.",
            "expected_files": [
                "interrupts.mdx",
                "langgraph/langgraph/types.py",
                "prebuilt/langgraph/prebuilt/interrupt.py",
                "prebuilt/langgraph/prebuilt/tool_node.py",
                "langgraph/langgraph/pregel/_loop.py"
            ],
            "concepts": [
                "interrupt IDs",
                "checkpoint namespace",
                "parallel tasks",
                "ToolNode",
                "resume map",
                "interrupt counter",
                "task-local resume state"
            ],
            "tags": [
                "parallel_interrupts",
                "interrupt_id",
                "ToolNode",
                "resume_map",
                "checkpoint_ns"
            ],
            "code_snippet": "from langgraph.graph import StateGraph, START, END\nfrom langgraph.prebuilt import ToolNode\nfrom langgraph.types import interrupt\nfrom langgraph.checkpoint.memory import InMemorySaver\n\n\ndef approval_tool(name: str):\n    return interrupt({\"tool\": name, \"question\": \"approve?\"})\n\n# Imagine three tool calls are dispatched concurrently and each tool\n# executes the interrupt above.\n# The application later observes three pending interrupts and attempts:\n# Command(resume={interrupt_1: \"yes\", interrupt_2: \"no\", interrupt_3: \"yes\"})",
            "observed_behavior": "Multiple concurrent tool executions can produce identical interrupt IDs and therefore cannot be independently addressed through a resume dictionary.",
            "expected_behavior": "Each independently resumable interrupt should have an unambiguous identity that can be mapped back to the correct pending task.",
            "error": "Multiple parallel interrupts receive the same ID, causing resume-map key collisions.",
            "logs": null,
            "evidence": null,
            "queries": [
                "How are LangGraph interrupt IDs generated from interrupt namespaces?",
                "Why can parallel ToolNode executions share an interrupt namespace?",
                "How does Interrupt.from_ns construct an interrupt identifier?",
                "How does the interrupt counter relate to resume-value matching?",
                "How does Command(resume={interrupt_id: value}) select a pending interrupt?",
                "Why can identical interrupt IDs collapse multiple parallel resume values?"
            ]
        },
